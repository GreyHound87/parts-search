{
  "name": "parts-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "biome:check": "biome check --error-on-warnings .",
    "biome:fix": "biome check --write .",
    "knip": "knip",
