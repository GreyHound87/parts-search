    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "steiger": "^0.9.0",
    "vite": "^8.3.5"
  }
}
